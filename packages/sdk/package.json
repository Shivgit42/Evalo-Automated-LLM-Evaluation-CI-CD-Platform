{
  "name": "@evalo/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Evalo — GitHub-native LLM evals.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "files": ["dist"],
  "keywords": ["llm", "evals", "openai", "anthropic", "observability"],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
